# ============================================================================
#  Configuration — copy to .env and fill in.  Only DISCORD_BOT_TOKEN is required;
#  everything else is optional and switches individual features on.
# ============================================================================

# --- Discord (required) ---
# Bot token from the Discord Developer Portal (Bot -> Reset Token).
# IMPORTANT for reaction roles: in the Portal under Bot -> Privileged Gateway
# Intents, enable the "Server Members Intent", otherwise Discord refuses the
# login and the container won't start. See README, section "Discord setup".
DISCORD_BOT_TOKEN=

# Your server (guild) ID. Right-click the server -> Copy ID (Developer Mode on).
# Strongly recommended: WITHOUT it NO slash commands register and the panel's
# channel/role dropdowns fall back to raw-ID entry.
DISCORD_GUILD_ID=

# --- Branding (white-label) ---
# Give each deployment its own look. All optional.
# BRAND_NAME overrides the admin-panel title (empty = the live bot name).
BRAND_NAME=
# Icon shown in the panel header and login screen.
BRAND_EMOJI=🤖
# Accent color of all embeds (live announcement + reaction-role posts).
# Hex, e.g. #5865f2 (Discord blurple) or #9146ff (Twitch purple). Empty = purple.
EMBED_COLOR=

# --- Live announcement / notify endpoint (optional) ---
# Target channel for the /notify go-live post. Only needed if you use the Twitch
# notification feature; a pure command / reaction-role bot runs without it.
# Developer Mode on -> right-click the channel -> Copy ID.
DISCORD_CHANNEL_ID=

# Start default for the go-live mention. Empty = no ping, "everyone" = @everyone,
# otherwise a role ID. Only the seed on first start (until data/settings.json
# exists) — after that it's edited in the panel under "Live announcement".
MENTION_ROLE_ID=

# Optional overrides for the user-facing /live and go-live strings.
# {streamer} is replaced with the channel name. Empty = sensible German defaults.
# LIVE_EMBED_TEXT=**{streamer}** is now live!
# LIVE_BUTTON_LABEL=Watch stream
# LIVE_OFFLINE_MESSAGE=**{streamer}** is not live right now.
# LIVE_ERROR_MESSAGE=Could not reach Twitch right now.

# --- Twitch /live command (optional) ---
# Only needed for the /live command. If any of the three is missing, /live is
# omitted and the other commands keep working. Same Twitch app as your n8n setup.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# The channel to monitor, lowercase (the part after twitch.tv/).
TWITCH_LOGIN=

# --- Twitch <-> Discord chat bridge (optional) ---
# Set = bridge available (on/off + channel are then set in the panel under
# "Chat-Brücke"). Also needs the three Twitch values above and ADMIN_PASSWORD.
# Enter exactly this under "OAuth Redirect URLs" in your Twitch app. Must point at
# the admin panel (same host); the path is free, e.g. /twitch/callback.
# WARNING: once set, the bot requests the "Message Content Intent" — enable it in
# the Discord Developer Portal (Bot -> Privileged Gateway Intents) or the
# container won't start. See README, "Twitch <-> Discord chat bridge".
TWITCH_REDIRECT_URI=

# --- Admin panel (optional) ---
# Empty = panel disabled. Choose a long password if enabled.
ADMIN_PASSWORD=
ADMIN_PORT=7855
# Which address the admin port binds to. Default 127.0.0.1 = only the server
# itself (reach it via SSH tunnel: ssh -L 7855:localhost:7855 user@server).
# For LAN access set the server's LAN IP, e.g. 192.168.1.50.
# 0.0.0.0 = all interfaces (only with a strong password, ideally behind a TLS proxy).
ADMIN_BIND=127.0.0.1

# Only set this when the panel runs behind a reverse proxy (accessed via a domain
# instead of an SSH tunnel). Without it the bot only sees the proxy IP and would
# lump all login attempts under one counter.
# "1" = exactly one proxy hop (the normal case) -> the real client IP from
# X-Forwarded-For counts again. Only set with a trusted proxy in front.
# Leave empty for SSH-tunnel access or no proxy.
ADMIN_TRUST_PROXY=

# --- Securing /notify (optional) ---
# Empty = open (endpoint is only reachable via the Docker gateway).
# Set = callers must send the header "X-Notify-Token: <value>".
NOTIFY_TOKEN=

# --- Docker / runtime ---
# Port of the internal notify endpoint. Also read by docker-compose.yml for the
# port mapping.
HTTP_PORT=7854
# Container name (docker-compose). Rename to run multiple branded instances.
BOT_CONTAINER_NAME=fetchbot
